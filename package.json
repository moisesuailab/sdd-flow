{
  "name": "sdd-flow",
  "version": "2.2.0",
  "description": "Portable spec-driven workflow with bounded context and evidence-based verification",
  "bin": {
    "sdd-cli": "bin/cli.js",
    "sdd": "bin/cli.js"
  },
  "files": [
    "bin/",
    "lib/",
    "templates/",
    "docs/",
    "!docs/guia-agentes.pt-BR.md",
    "CHANGELOG.md",
    "README.pt-BR.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "sdd",
    "spec-driven-development",
    "rpiv",
    "ai-workflow",
    "claude-code",
    "opencode",
    "agentic",
    "workflow"
  ],
  "author": "moisesuailab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moisesuailab/sdd-flow.git"
  },
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check-package.js",
    "test:coverage": "node --test --experimental-test-coverage",
    "release:check": "node scripts/release-check.js",
    "prepublishOnly": "npm test && npm run check"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "homepage": "https://github.com/moisesuailab/sdd-flow#readme",
  "bugs": {
    "url": "https://github.com/moisesuailab/sdd-flow/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
